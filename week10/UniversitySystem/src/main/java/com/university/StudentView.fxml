<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.university.StudentController" style="-fx-background-color: #FFF0F3;">

    <!-- TOP BAR - ROSE GOLD -->
    <top>
        <VBox spacing="4" style="-fx-background-color: linear-gradient(to right, #B76E79, #E8B4B8, #F9C5D5); -fx-padding: 26 28 22 28;">
            <Label text="✦  UNIVERSITY SYSTEM  ✦" style="-fx-text-fill: #FFF5F7; -fx-font-size: 13px; -fx-font-weight: bold; -fx-letter-spacing: 3px;"/>
            <Label text="Student Management" style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 4, 0, 0, 1);"/>
            <Label text="Manage registrations, view students and add new records in real time." style="-fx-text-fill: #FFF0F3; -fx-font-size: 14px;"/>
        </VBox>
    </top>

    <!-- CENTER -->
    <center>
        <VBox spacing="18" style="-fx-padding: 24 28 24 28;">
            <!-- FORM CARD -->
            <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(183,110,121,0.18), 16, 0, 0, 4); -fx-border-color: #FCE7F3; -fx-border-width: 1; -fx-border-radius: 18;">
                <Label text="✦  Add New Student" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #9D5C6A;"/>
                <HBox spacing="12">
                    <TextField fx:id="regField" promptText="Reg Number  e.g. SCT212-001" prefWidth="190" style="-fx-background-radius: 12; -fx-padding: 12; -fx-background-color: #FFF5F7; -fx-border-color: #FBCFE8; -fx-border-radius: 12; -fx-font-size: 13px;"/>
                    <TextField fx:id="firstNameField" promptText="First Name" prefWidth="190" style="-fx-background-radius: 12; -fx-padding: 12; -fx-background-color: #FFF5F7; -fx-border-color: #FBCFE8; -fx-border-radius: 12; -fx-font-size: 13px;"/>
                    <TextField fx:id="lastNameField" promptText="Last Name" prefWidth="190" style="-fx-background-radius: 12; -fx-padding: 12; -fx-background-color: #FFF5F7; -fx-border-color: #FBCFE8; -fx-border-radius: 12; -fx-font-size: 13px;"/>
                    <Button fx:id="saveButton" text="♡  Save Student" onAction="#handleSaveStudent" style="-fx-background-color: linear-gradient(to right, #B76E79, #E5989B); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 12; -fx-padding: 12 22 12 22; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(183,110,121,0.35), 8, 0, 0, 2);"/>
                </HBox>
                <Label fx:id="statusLabel" text="Ready ♡" style="-fx-text-fill: #BE8A96; -fx-font-size: 13px; -fx-font-style: italic;"/>
            </VBox>

            <!-- TABLE CARD -->
            <VBox spacing="12" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(183,110,121,0.18), 16, 0, 0, 4); -fx-border-color: #FCE7F3; -fx-border-width: 1; -fx-border-radius: 18;">
                <Label text="♡  Registered Students" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #9D5C6A;"/>
                <TableView fx:id="studentTable" VBox.vgrow="ALWAYS" style="-fx-background-color: #FFF5F7; -fx-background-radius: 12; -fx-border-color: #FBCFE8; -fx-border-radius: 12;">
                    <columns>
                        <TableColumn fx:id="colReg" text="Reg Number" prefWidth="200"/>
                        <TableColumn fx:id="colFirst" text="First Name" prefWidth="200"/>
                        <TableColumn fx:id="colLast" text="Last Name" prefWidth="200"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>